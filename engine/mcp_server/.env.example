# coscientist mcp server environment configuration
# copy this file to .env and fill in your configuration

# ===== Required Configuration =====

# pubmed search (via ncbi entrez)
# required - used for pubmed api identification
ENTREZ_EMAIL=your_email@example.com
ENTREZ_API_KEY=

# set to true during development if your OS, AV, or proxy breaks the TLS
# connection to NCBI/PubMed (read by entrez.py)

# literature review cache directory
# where downloaded papers and metadata are stored
# (the code default when this is unset is ./cache/literature_review)
COSCIENTIST_LIT_REVIEW_DIR=./paper_cache

# optional metadata/PMC-link batching; full-text downloads keep their existing path
# disabled by default; set to 1 only when explicitly enabling the batching path
COSCIENTIST_PUBMED_METADATA_BATCH=0

# ===== OpenAlex (keyless, cross-disciplinary) =====

# optional. contact email for OpenAlex's "polite pool" (faster, more reliable
# responses). ENTREZ_EMAIL above wins when both are set, so this is consulted
# only when ENTREZ_EMAIL is unset; if BOTH are unset the OpenAlex source still
# works but is silently downgraded to the slower shared pool. set either to
# identify yourself.
# OPENALEX_MAILTO=your_email@example.com

# optional. OpenAlex premium api key, if you have one (unset = keyless access).
# OPENALEX_API_KEY=

# server port
COSCIENTIST_MCP_PORT=8888
COSCIENTIST_MCP_LOG_LEVEL=INFO

# ===== Web search =====

# optional. set a key to enable the search_web tool; without one the tool is
# not registered at all and agents fall back to the academic sources.
# the read_url browsing tool needs no key and is always available.

# which provider to try FIRST: brave or tavily. leave unset to auto-detect
# from whichever key below is set (brave is preferred). this names a
# preference, not the only provider: set both keys and the two monthly
# allowances chain, since a provider that refuses the key (401/402/403, or
# tavily's 432/433 once the month's credits are spent) is skipped and the
# search falls through to the other one.
WEB_SEARCH_PROVIDER=

# brave search api (independent index, low latency). NOTE: brave withdrew
# its free tier in Feb 2026 -- a key from the old free tier now answers 402
# with a zero monthly allowance, and the current plan needs a card on file.
BRAVE_API_KEY=

# tavily (agent-oriented, returns extracted page content with results).
# free "Researcher" plan: 1,000 credits/month, resets monthly, no card. one
# basic search -- what this server sends -- costs 1 credit.
TAVILY_API_KEY=

# ===== Shared-secret auth (N7) =====

# optional. when set, every MCP call (other than the plain "/" status
# route) must carry this value in the X-MCP-Shared-Secret header, or the
# server refuses it with 401. unset (the default) reproduces the prior
# behaviour exactly: no header is required, since this is a reference
# server the user deploys by hand and a token that hard-fails on rollout
# would take production down. set the SAME value here and in the engine's
# environment (the client reads it from this same variable name) -- the
# private network stays the outer control, this is the inner one.
# COSCIENTIST_MCP_SHARED_SECRET=

# ===== INDRA CoGex Knowledge Graph =====

# INDRA CoGex API base URL (default: public instance)
# INDRA_COGEX_URL=https://discovery.indra.bio

# request timeout in seconds (some queries on large networks can be slow).
# the code default is 120.
# INDRA_COGEX_TIMEOUT=120
