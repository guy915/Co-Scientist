# coscientist mcp server environment configuration
# copy this file to .env and fill in your configuration

# ===== Required Configuration =====

# pubmed search (via ncbi entrez)
# required - used for pubmed api identification
ENTREZ_EMAIL=your_email@example.com
ENTREZ_API_KEY=

# set to true during development if your OS, AV, or proxy breaks the TLS
# connection to NCBI/PubMed (read by entrez.py)
DISABLE_SSL_VERIFY=false

# literature review cache directory
# where downloaded papers and metadata are stored
COSCIENTIST_LIT_REVIEW_DIR=./paper_cache

# server port
COSCIENTIST_MCP_PORT=8888
COSCIENTIST_MCP_LOG_LEVEL=INFO

# ===== Web search =====

# optional. set a key to enable the search_web tool; without one the tool is
# not registered at all and agents fall back to the academic sources.
# the read_url browsing tool needs no key and is always available.

# which provider to use: brave or tavily. leave unset to auto-detect from
# whichever key below is set (brave is preferred).
WEB_SEARCH_PROVIDER=

# brave search api (independent index, low latency)
BRAVE_API_KEY=

# tavily (agent-oriented, returns extracted page content with results)
TAVILY_API_KEY=

# ===== INDRA CoGex Knowledge Graph =====

# INDRA CoGex API base URL (default: public instance)
# INDRA_COGEX_URL=https://discovery.indra.bio

# request timeout in seconds (some queries on large networks can be slow)
# INDRA_COGEX_TIMEOUT=60