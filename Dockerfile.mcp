# syntax=docker/dockerfile:1
# Build from repo root: docker build -f Dockerfile.mcp .
#
# Sibling: engine/mcp_server/Dockerfile (local/compose). The two are
# deliberately divergent -- this one (Railway) builds from the repo root so it
# can COPY the corpus in and set SBI_CORPUS_DIR, and binds IPv6 (`--host ::`)
# with an [::1] healthcheck for Railway's IPv6 private network. The engine-local
# file builds from engine/, ships no corpus, and binds 0.0.0.0. A change to the
# server install, bind host, or healthcheck here usually needs a mirrored change
# there.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y build-essential && rm -rf /var/lib/apt/lists/*

# Dependencies from metadata alone, so editing server source does not
# recompile biopython/lxml; the source tree lands in the next COPY.
COPY engine/mcp_server/pyproject.toml ./mcp_server/
RUN pip install --no-cache-dir -e ./mcp_server
COPY engine/mcp_server/ ./mcp_server/

# The research group's own papers, as sanitized text. Copied after the install
# so editing the corpus does not invalidate the dependency layer. The corpus
# tools read SBI_CORPUS_DIR and have no default: without both this COPY and the
# env var they return empty, which is indistinguishable from "no match", so the
# two must stay together. Absent corpus is not an error -- deployments without
# one simply serve no group papers.
COPY corpus/ ./corpus/
ENV SBI_CORPUS_DIR=/app/corpus/sbi_ucd

ENV PYTHONUNBUFFERED=1

EXPOSE 8888

# Listen on a fixed internal port (matches the api's MCP_SERVER_URL) and bind
# IPv6 (::) so Railway's IPv6 private network (mcp.railway.internal) can reach
# it. Railway injects its own PORT (e.g. 8080) for public ingress, but this
# service is private-only, so we ignore it and pin 8888 on both ends.
# Probe the IPv6 loopback explicitly: `--host ::` is IPv6-only on some kernels
# (not always dual-stack), so a `localhost`/127.0.0.1 healthcheck can miss the
# socket. [::1] matches the bind regardless of dual-stack behavior.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://[::1]:8888', timeout=5.0)" || exit 1

CMD ["sh", "-c", "uvicorn mcp_server.server:app --host :: --port 8888"]
