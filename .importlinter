    app.free_usage -> app.auth
    app.free_usage -> app.engine_adapter
    app.free_usage -> app.runs.models
    app.interviews -> app.api_contracts.interviews
    app.interviews -> app.auth
    app.interviews.questions -> co_scientist.schemas.builders
    app.interviews.stream -> app.sse
    app.interviews.turns -> app.auth
    app.llm_request -> app.credentials
    app.logging_setup -> app.credentials
    app.offline_guard -> app.credentials
    app.offline_guard -> app.engine_adapter
    app.process_mode -> app.credentials
    app.qa -> app.sse
