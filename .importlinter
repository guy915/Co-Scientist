# Import contracts for docs/adr/001-module-map.md, checked by `make arch`.
# Modules keep their current names; each move PR renames them here.
# Every ignore_imports entry is a current violation. A fix deletes its entry;
# evaluations/tests/test_import_contracts.py pins the count, so it only shrinks.
# Package __init__ modules whose children belong to different layers stay out of
# the layers until they move: app.engine_adapter, app.engine_adapter.drain,
# co_scientist.agents, co_scientist.config and co_scientist.models.
# Run from app/ (make arch): from the repository root, `app` resolves to the
# app/ directory instead of the package.

[importlinter]
root_packages =
    co_scientist
    app
include_external_packages = True

[importlinter:contract:layers]
name = Layers (ADR-001)
type = layers
layers =
    (co_scientist.main) : app.main
    (co_scientist.api) : app.api_contracts : app.runs : app.diagnostics_api : app.diagnostics : app.logs_api : app.feedback_api : app.documents : app.sse : app.operator_access : app.auth
    (co_scientist.orchestration) : co_scientist.workflow_topology : co_scientist.task_runtime : co_scientist.checkpoint : co_scientist.generator : app.engine_tasks : app.task_worker : app.run_events : app.notifications : app.engine_adapter.opts : app.engine_adapter.events : app.engine_adapter.drain.final_state : app.store.tasks : app.store.tasks_lifecycle : app.store.runs : app.store.runs_views : app.store.events : app.store.supervisor_plan : app.store.receipts
    (co_scientist.science) : co_scientist.agents.generation : co_scientist.agents.reflection : co_scientist.agents.ranking : co_scientist.agents.evolution : co_scientist.agents.proximity : co_scientist.agents.meta_review : co_scientist.agents.supervisor : co_scientist.agents.safety : co_scientist.agents.node_degradation : co_scientist.scheduling : co_scientist.prompts : co_scientist.schemas : co_scientist.research
    (co_scientist.domains.chat) : app.qa : app.interviews : app.run_start_announcement : app.goal_text : app.seed : app.store.messages : app.store.interviews : app.store.examples
    (co_scientist.domains.report) : app.report : app.store.reports
    (co_scientist.domains.safety) : co_scientist.safety : app.safety : app.hypothesis
    (co_scientist.domains.research_state) : co_scientist.models.matchup : co_scientist.state : app.elo : app.text_utils : app.claims : app.store.hypotheses : app.store.records : app.engine_adapter.drain.hypotheses : app.engine_adapter.drain.reviews : app.engine_adapter.drain.matches
    (co_scientist.domains.documents) : app.document_ingest : app.pdf : app.pdf_worker : app.evidence_chunking : app.staged_documents : app.store.documents : (co_scientist.domains.access) : app.credentials : app.byok_models : app.free_usage : app.retention : (co_scientist.domains.feedback) : app.store.feedback
    (co_scientist.platform.retrieval) : co_scientist.mcp_client : co_scientist.tools : co_scientist.config.registry : co_scientist.config.schema : co_scientist.evidence : co_scientist.retrieval_degradation : co_scientist.research_adapter : app.pinned_http : app.retraction_set : app.citations : app.run_corpus : app.engine_adapter.tools
    (co_scientist.platform.llm) : co_scientist.llm : co_scientist.offline : co_scientist.tool_effects : app.llm_request : app.llm_scope : app.execution_policy : app.process_mode : app.offline_guard : app.provider_usage : (co_scientist.platform.sandbox) : co_scientist.sandbox : co_scientist.workspace : co_scientist.skills : co_scientist.patch : (co_scientist.platform.db) : app.store.db : app.store.schema : app.store.checkpoints : app.store.models
    (co_scientist.platform.telemetry) : co_scientist.progress : app.logging_setup : app.error_tracking : app.diagnostic_events : app.store.logs : app.store.retrieval_calls
    (co_scientist.core) : co_scientist.exceptions : co_scientist._context : co_scientist.backoff : co_scientist.config.env_vars : co_scientist.models.metrics : co_scientist.constants : app.config : app.run_modes : app.async_bridge
ignore_imports =
    app.claims.grounding -> app.engine_adapter
    app.claims.verifier -> co_scientist.schemas.builders
    app.config -> co_scientist.llm
    app.engine_adapter.drain.matches -> co_scientist.agents.ranking.ranking_debate
    app.engine_adapter.drain.matches -> co_scientist.research
    app.engine_adapter.drain.reviews -> app.report
    app.error_tracking -> app.credentials
