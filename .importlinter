# Import contracts for docs/adr/001-module-map.md, checked by `make arch`.
# Modules keep their current names; each move PR renames them here.
# Every ignore_imports entry is a current violation. A fix deletes its entry;
# evaluations/tests/test_import_contracts.py pins the count, so it only shrinks.
# Run from app/ (make arch): from the repository root, `app` resolves to the
# app/ directory instead of the package.

[importlinter]
root_packages =
    co_scientist
    app
include_external_packages = True

[importlinter:contract:layers]
name = Layers (ADR-001)
type = layers
layers =
    (co_scientist.main) : app.main
    co_scientist.api
    co_scientist.orchestration
    co_scientist.science
    co_scientist.domains.chat
    co_scientist.domains.report
    co_scientist.domains.safety
    co_scientist.domains.research_state
    co_scientist.domains.documents : co_scientist.domains.access : co_scientist.domains.feedback
    co_scientist.platform.retrieval
    co_scientist.platform.llm : co_scientist.platform.sandbox : co_scientist.platform.db
    co_scientist.platform.telemetry
    co_scientist.core
ignore_imports =
    co_scientist.domains.research_state.claims.grounding -> co_scientist.orchestration.engine_adapter
    co_scientist.core.config -> co_scientist.platform.llm
    co_scientist.domains.research_state.drain.matches -> co_scientist.science.ranking.ranking_debate
    co_scientist.domains.research_state.drain.matches -> co_scientist.science.research
    co_scientist.domains.documents.evidence_chunking -> co_scientist.domains.research_state.claims.assessor
    co_scientist.domains.access.free_usage -> co_scientist.api.auth
    co_scientist.domains.access.free_usage -> co_scientist.orchestration.engine_adapter
    co_scientist.domains.access.free_usage -> co_scientist.api.runs.models
    co_scientist.domains.chat.interviews -> co_scientist.api.contracts.interviews
    co_scientist.domains.chat.interviews -> co_scientist.api.auth
    co_scientist.domains.chat.interviews.turns -> co_scientist.api.auth
    co_scientist.platform.llm.offline_guard -> co_scientist.orchestration.engine_adapter
    co_scientist.domains.chat.qa -> co_scientist.orchestration.repository.runs
    co_scientist.domains.chat.qa.manifest -> co_scientist.orchestration.repository.events
    co_scientist.domains.chat.qa.manifest -> co_scientist.orchestration.repository.tasks
    co_scientist.domains.chat.qa.snapshot -> co_scientist.orchestration.repository.supervisor_plan
    co_scientist.domains.chat.qa.snapshot -> co_scientist.orchestration.checkpoint
    co_scientist.domains.report.content -> co_scientist.science.reflection.reflection_helpers
    co_scientist.domains.report.finalize -> co_scientist.orchestration.engine_tasks.runtime
    co_scientist.domains.report.finalize -> co_scientist.orchestration.engine_tasks.support
    co_scientist.domains.report.finalize -> co_scientist.orchestration.notifications
    co_scientist.domains.report.finalize -> co_scientist.orchestration.run_events
    co_scientist.domains.report.finalize -> co_scientist.orchestration.repository.events
    co_scientist.domains.report.finalize -> co_scientist.orchestration.repository.runs
    co_scientist.domains.access.retention -> co_scientist.orchestration.repository.runs
    co_scientist.domains.access.retention -> co_scientist.orchestration.repository.runs_views
    co_scientist.domains.safety.gate -> co_scientist.orchestration.engine_tasks.support
    co_scientist.domains.safety.gate -> co_scientist.orchestration.repository.events
    co_scientist.domains.safety.gate -> co_scientist.orchestration.repository.runs
    co_scientist.domains.safety.gate -> co_scientist.orchestration.task_worker.outcomes
    co_scientist.domains.chat.seed -> co_scientist.orchestration.repository.runs_views
    co_scientist.platform.db.checkpoints -> co_scientist.orchestration.repository.supervisor_plan
    co_scientist.domains.documents.repository -> co_scientist.domains.research_state.repository.records
    co_scientist.domains.chat.repository.examples -> co_scientist.orchestration.repository.runs
    co_scientist.platform.telemetry.logs -> co_scientist.platform.db
    co_scientist.platform.telemetry.retrieval_calls -> co_scientist.platform.db
    co_scientist.platform.telemetry.retrieval_calls -> co_scientist.science.research
    co_scientist.core.constants -> co_scientist.platform.llm.profile
    co_scientist.platform.retrieval.evidence.article_support -> co_scientist.domains.research_state.models
    co_scientist.platform.retrieval.evidence.article_support -> co_scientist.science.research
    co_scientist.platform.retrieval.evidence.relevance -> co_scientist.science.prompts
    co_scientist.platform.retrieval.evidence.relevance -> co_scientist.science.schemas
    co_scientist.platform.retrieval.evidence.search -> co_scientist.domains.research_state.state
    co_scientist.platform.retrieval.evidence.search_support -> co_scientist.domains.research_state.state
    co_scientist.core.metrics -> co_scientist.platform.llm
    co_scientist.platform.telemetry.progress -> co_scientist.domains.research_state.state
    co_scientist.platform.retrieval.research_adapter -> co_scientist.science.prompts
    co_scientist.platform.retrieval.research_adapter -> co_scientist.science.research
    co_scientist.platform.llm.tool_effects -> co_scientist.platform.retrieval.config.registry
    co_scientist.platform.retrieval.tools.response_parser -> co_scientist.domains.research_state.models
    co_scientist.platform.sandbox.workspace.tools -> co_scientist.platform.retrieval.tools.provider

[importlinter:contract:agents]
name = Science agents are independent
type = independence
modules =
    co_scientist.science.generation
    co_scientist.science.reflection
    co_scientist.science.ranking
    co_scientist.science.evolution
    co_scientist.science.proximity
    co_scientist.science.meta_review
    co_scientist.science.supervisor
    co_scientist.science.safety_screen
ignore_imports =
    co_scientist.science.evolution.evolve_grounding -> co_scientist.science.reflection.deep_verification_evidence
    co_scientist.science.evolution.evolve_prompt -> co_scientist.science.generation.assumptions
    co_scientist.science.evolution.evolve_prompt -> co_scientist.science.proximity.proximity_graph
    co_scientist.science.evolution.evolve_prompt -> co_scientist.science.reflection.review_gate
    co_scientist.science.evolution.evolve_results -> co_scientist.science.generation.citations
    co_scientist.science.evolution.operations -> co_scientist.science.generation.citations
    co_scientist.science.generation.literature_review.enrichment -> co_scientist.science.reflection.reflection_helpers
    co_scientist.science.generation.operations -> co_scientist.science.meta_review.research_overview
    co_scientist.science.meta_review.meta_review -> co_scientist.science.reflection.review_gate
    co_scientist.science.meta_review.meta_review -> co_scientist.science.safety_screen
    co_scientist.science.ranking.ranking_debate -> co_scientist.science.reflection.review_gate
    co_scientist.science.supervisor.orchestrator -> co_scientist.science.ranking.ranking_lifecycle
    co_scientist.science.supervisor.orchestrator -> co_scientist.science.reflection.owed_review

[importlinter:contract:fastapi]
name = FastAPI only in api and main
type = forbidden
source_modules =
    co_scientist.orchestration
    co_scientist.science
    co_scientist.domains.chat
    co_scientist.domains.report
    co_scientist.domains.safety
    co_scientist.domains.research_state
    co_scientist.domains.documents
    co_scientist.domains.access
    co_scientist.domains.feedback
    co_scientist.platform.retrieval
    co_scientist.platform.llm
    co_scientist.platform.sandbox
    co_scientist.platform.db
    co_scientist.platform.telemetry
    co_scientist.core
forbidden_modules =
    fastapi
    starlette
allow_indirect_imports = True
ignore_imports =
    co_scientist.domains.access.byok_models -> fastapi
    co_scientist.domains.documents.ingest -> fastapi
    co_scientist.domains.access.free_usage -> fastapi
    co_scientist.domains.chat.interviews -> fastapi
    co_scientist.domains.chat.interviews.model -> fastapi
    co_scientist.domains.chat.interviews.stream -> fastapi
    co_scientist.domains.chat.interviews.turns -> fastapi
    co_scientist.platform.llm.provider_usage -> fastapi
    co_scientist.domains.documents.staged -> fastapi

