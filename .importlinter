    app.run_modes -> app.elo
    app.run_start_announcement -> app.sse
    app.safety -> app.engine_tasks.support
    app.safety -> app.store.events
    app.safety -> app.store.runs
    app.safety -> app.task_worker.outcomes
    app.safety.semantic -> co_scientist.schemas.builders
    app.seed -> app.store.runs_views
    app.store.checkpoints -> app.store.supervisor_plan
    app.store.documents -> app.store.records
    app.store.examples -> app.store.runs
    app.store.logs -> app.store.db
    app.store.retrieval_calls -> app.store.db
    app.store.retrieval_calls -> co_scientist.research
    co_scientist.constants -> co_scientist.llm.profile
    co_scientist.evidence.article_support -> co_scientist.models
    co_scientist.evidence.article_support -> co_scientist.research
    co_scientist.evidence.relevance -> co_scientist.prompts
    co_scientist.evidence.relevance -> co_scientist.schemas
    co_scientist.evidence.search -> co_scientist.state
    co_scientist.evidence.search_support -> co_scientist.state
    co_scientist.models.metrics -> co_scientist.llm
    co_scientist.progress -> co_scientist.state
    co_scientist.research_adapter -> co_scientist.prompts
    co_scientist.research_adapter -> co_scientist.research
    co_scientist.tool_effects -> co_scientist.config.registry
    co_scientist.tools.response_parser -> co_scientist.models
    co_scientist.workspace.tools -> co_scientist.tools.provider

[importlinter:contract:agents]
name = Science agents are independent
type = independence
modules =
    co_scientist.agents.generation
    co_scientist.agents.reflection
    co_scientist.agents.ranking
    co_scientist.agents.evolution
    co_scientist.agents.proximity
    co_scientist.agents.meta_review
    co_scientist.agents.supervisor
    co_scientist.agents.safety
