# Import contracts for docs/adr/001-module-map.md, checked by `make arch`.
# Modules keep their current names; each move PR renames them here.
# Every ignore_imports entry is a current violation. A fix deletes its entry;
# evaluations/tests/test_import_contracts.py pins the count, so it only shrinks.
# Package __init__ modules whose children belong to different layers stay out of
# the layers until they move: app.engine_adapter, app.engine_adapter.drain and
# co_scientist.agents.
# Run from app/ (make arch): from the repository root, `app` resolves to the
# app/ directory instead of the package.

[importlinter]
root_packages =
    co_scientist
    app
include_external_packages = True

[importlinter:contract:layers]
name = Layers (ADR-001)
type = layers
layers =
    (co_scientist.main) : app.main
    (co_scientist.api) : app.api_contracts : app.runs : app.diagnostics_api : app.diagnostics : app.logs_api : app.feedback_api : app.documents : app.sse : app.operator_access : app.auth
    co_scientist.orchestration : co_scientist.workflow_topology : co_scientist.task_runtime : co_scientist.checkpoint : co_scientist.generator : app.engine_tasks : app.task_worker : app.run_events : app.notifications : app.engine_adapter.opts : app.engine_adapter.events : app.store.tasks : app.store.tasks_lifecycle : app.store.runs : app.store.runs_views : app.store.events : app.store.supervisor_plan : app.store.receipts
    (co_scientist.science) : co_scientist.agents.generation : co_scientist.agents.reflection : co_scientist.agents.ranking : co_scientist.agents.evolution : co_scientist.agents.proximity : co_scientist.agents.meta_review : co_scientist.agents.supervisor : co_scientist.agents.safety : co_scientist.agents.node_degradation : co_scientist.scheduling : co_scientist.prompts : co_scientist.schemas : co_scientist.research
    co_scientist.domains.chat
    (co_scientist.domains.report) : app.report : app.store.reports
    (co_scientist.domains.safety) : co_scientist.safety : app.safety : app.hypothesis
    co_scientist.domains.research_state
    (co_scientist.domains.documents) : app.document_ingest : app.pdf : app.pdf_worker : app.evidence_chunking : app.staged_documents : app.store.documents : (co_scientist.domains.access) : app.credentials : app.byok_models : app.free_usage : app.retention : (co_scientist.domains.feedback) : app.store.feedback
    co_scientist.platform.retrieval
    co_scientist.platform.llm : co_scientist.platform.sandbox : co_scientist.platform.db
    co_scientist.platform.telemetry
    co_scientist.core
ignore_imports =
    co_scientist.domains.research_state.claims.grounding -> app.engine_adapter
    co_scientist.domains.research_state.claims.verifier -> co_scientist.schemas.builders
    co_scientist.core.config -> co_scientist.platform.llm
    co_scientist.domains.research_state.drain.matches -> co_scientist.agents.ranking.ranking_debate
    co_scientist.domains.research_state.drain.matches -> co_scientist.research
    co_scientist.domains.research_state.drain.reviews -> app.report
    co_scientist.platform.telemetry.error_tracking -> app.credentials
    app.evidence_chunking -> co_scientist.domains.research_state.claims.assessor
    app.free_usage -> app.auth
    app.free_usage -> app.engine_adapter
    app.free_usage -> app.runs.models
    co_scientist.domains.chat.interviews -> app.api_contracts.interviews
    co_scientist.domains.chat.interviews -> app.auth
    co_scientist.domains.chat.interviews.questions -> co_scientist.schemas.builders
    co_scientist.domains.chat.interviews.stream -> app.sse
    co_scientist.domains.chat.interviews.turns -> app.auth
    co_scientist.platform.llm.llm_request -> app.credentials
    co_scientist.platform.telemetry.logging_setup -> app.credentials
    co_scientist.platform.llm.offline_guard -> app.credentials
    co_scientist.platform.llm.offline_guard -> app.engine_adapter
    co_scientist.platform.llm.process_mode -> app.credentials
    co_scientist.domains.chat.qa -> app.sse
    co_scientist.domains.chat.qa -> app.store.runs
    co_scientist.domains.chat.qa.manifest -> app.store.events
    co_scientist.domains.chat.qa.manifest -> app.store.tasks
    co_scientist.domains.chat.qa.snapshot -> app.store.supervisor_plan
    co_scientist.domains.chat.qa.snapshot -> co_scientist.checkpoint
    app.report.content -> co_scientist.agents.reflection.reflection_helpers
    app.report.finalize -> app.engine_tasks.runtime
    app.report.finalize -> app.engine_tasks.support
    app.report.finalize -> app.notifications
    app.report.finalize -> app.run_events
    app.report.finalize -> app.store.events
    app.report.finalize -> app.store.runs
    app.retention -> app.store.runs
    app.retention -> app.store.runs_views
    co_scientist.core.run_modes -> co_scientist.domains.research_state.elo
    co_scientist.domains.chat.run_start_announcement -> app.sse
    app.safety -> app.engine_tasks.support
    app.safety -> app.store.events
    app.safety -> app.store.runs
    app.safety -> app.task_worker.outcomes
    app.safety.semantic -> co_scientist.schemas.builders
    co_scientist.domains.chat.seed -> app.store.runs_views
    co_scientist.platform.db.checkpoints -> app.store.supervisor_plan
    app.store.documents -> co_scientist.domains.research_state.repository.records
    co_scientist.domains.chat.repository.examples -> app.store.runs
    co_scientist.platform.telemetry.logs -> co_scientist.platform.db
    co_scientist.platform.telemetry.retrieval_calls -> co_scientist.platform.db
    co_scientist.platform.telemetry.retrieval_calls -> co_scientist.research
    co_scientist.core.constants -> co_scientist.platform.llm.profile
    co_scientist.platform.retrieval.evidence.article_support -> co_scientist.domains.research_state.models
    co_scientist.platform.retrieval.evidence.article_support -> co_scientist.research
    co_scientist.platform.retrieval.evidence.relevance -> co_scientist.prompts
    co_scientist.platform.retrieval.evidence.relevance -> co_scientist.schemas
    co_scientist.platform.retrieval.evidence.search -> co_scientist.domains.research_state.state
    co_scientist.platform.retrieval.evidence.search_support -> co_scientist.domains.research_state.state
    co_scientist.core.metrics -> co_scientist.platform.llm
    co_scientist.platform.telemetry.progress -> co_scientist.domains.research_state.state
    co_scientist.platform.retrieval.research_adapter -> co_scientist.prompts
    co_scientist.platform.retrieval.research_adapter -> co_scientist.research
    co_scientist.platform.llm.tool_effects -> co_scientist.platform.retrieval.config.registry
    co_scientist.platform.retrieval.tools.response_parser -> co_scientist.domains.research_state.models
    co_scientist.platform.sandbox.workspace.tools -> co_scientist.platform.retrieval.tools.provider

[importlinter:contract:agents]
name = Science agents are independent
type = independence
modules =
    co_scientist.agents.generation
    co_scientist.agents.reflection
    co_scientist.agents.ranking
    co_scientist.agents.evolution
    co_scientist.agents.proximity
    co_scientist.agents.meta_review
    co_scientist.agents.supervisor
    co_scientist.agents.safety
ignore_imports =
    co_scientist.agents.evolution.evolve_grounding -> co_scientist.agents.reflection.deep_verification_evidence
    co_scientist.agents.evolution.evolve_prompt -> co_scientist.agents.generation.assumptions
    co_scientist.agents.evolution.evolve_prompt -> co_scientist.agents.proximity.proximity_graph
    co_scientist.agents.evolution.evolve_prompt -> co_scientist.agents.reflection.review_gate
    co_scientist.agents.evolution.evolve_results -> co_scientist.agents.generation.citations
    co_scientist.agents.evolution.operations -> co_scientist.agents.generation.citations
    co_scientist.agents.generation.literature_review.enrichment -> co_scientist.agents.reflection.reflection_helpers
    co_scientist.agents.generation.operations -> co_scientist.agents.meta_review.research_overview
    co_scientist.agents.meta_review.meta_review -> co_scientist.agents.reflection.review_gate
    co_scientist.agents.meta_review.meta_review -> co_scientist.agents.safety
    co_scientist.agents.ranking.ranking_debate -> co_scientist.agents.reflection.review_gate
    co_scientist.agents.supervisor.orchestrator -> co_scientist.agents.ranking.ranking_lifecycle
    co_scientist.agents.supervisor.orchestrator -> co_scientist.agents.reflection.owed_review

