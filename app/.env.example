# LLM configuration
#
# Leave provider keys empty to run on the engine's deterministic offline LLM
# backend. Set any supported LiteLLM provider key to use the real engine.
MODEL_NAME=openrouter/minimax/minimax-m3:free
# Real-engine claim verification defaults to semantic entailment. Set to
# deterministic only for offline development or explicit compatibility tests.
CLAIM_ASSESSOR=llm

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# The key the model names below need: Minimax M3's free pool, routed
# through OpenRouter, heading an all-free fallback chain for when that
# model's own daily cap (~100 requests/day per free model) is spent (see
# co_scientist.llm_gateway_routing._GATEWAY_MODELS).
OPENROUTER_API_KEY=

# Four settings, one model. They stay separate because they address
# different work, not because they must differ:
#   MODEL_NAME            → worker nodes: generate, review, ranking,
#       reflection, evolve, proximity, literature_review, claim verification.
#   SUPERVISOR_MODEL_NAME → supervisor (planning), meta_review and
#       research_overview (final report synthesis).
#   CHAT_MODEL_NAME       → user-facing communication: research interview,
#       Chat-tab Q&A, session titling.
#   SEMANTIC_SAFETY_MODEL → safety screening.
# Free on every tier, so there is no cheaper rung for a worker tier to drop
# to and no budget freed by giving the strategic tier something dearer.
SUPERVISOR_MODEL_NAME=openrouter/minimax/minimax-m3:free
CHAT_MODEL_NAME=openrouter/minimax/minimax-m3:free
SEMANTIC_SAFETY_MODEL=openrouter/minimax/minimax-m3:free

# Per-call LLM wall-clock ceiling in seconds (optional). Bounds the
# pathological case of a provider that accepts a request and then never
# responds, which would otherwise park a durable run forever. The default is
# deliberately generous -- reasoning models legitimately spend minutes on a
# large meta-review or ranking synthesis -- so it only fires on a genuine
# hang, not on normal latency. Set to 0 to disable the ceiling entirely.
# COSCIENTIST_LLM_TIMEOUT_SECONDS=600

# MCP server configuration (optional, required only for literature tools)
# MCP_SERVER_URL: URL of the MCP server providing literature review tools
# Leave empty or comment out to disable literature review (graceful degradation)
MCP_SERVER_URL=http://localhost:8888/mcp

# Server Configuration
HOST=0.0.0.0
PORT=8008

COSCIENTIST_DEBUG=FALSE

# Worker concurrency (optional). How many durable tasks one run executes at
# once (per-hypothesis reviews, verifications, generation strategies). The
# ceiling is NOT the provider -- it is SQLite's single writer: every task
# boundary commits a checkpoint, and in production twelve (times several
# concurrent runs) saturated the write lock and ordinary API writes failed.
# 8 buys most of the overlap while leaving the writer headroom. (default 8)
# WORKER_POOL_SIZE=8
# Per-client ceiling on runs in flight at once; over it, start returns 409.
# Scoped per client, so one researcher never consumes another's allowance.
# (default 10)
# MAX_CONCURRENT_RUNS=10
# Run the durable worker cohort inside the API process (1) or expect a
# separate `python -m app.task_worker` service (0). (default 1)
# COSCIENTIST_EMBEDDED_WORKER=1

# Cache configuration (optional)
COSCIENTIST_CACHE_ENABLED=true
COSCIENTIST_CACHE_DIR=./cache

# Storage paths (optional). Read directly from the environment by app/store/db.py.
# COSCIENTIST_DB_PATH: SQLite database path. Unset uses the app default.
# COSCIENTIST_REPORTS_DIR: directory for rendered Markdown reports (default ./reports).
# COSCIENTIST_DB_PATH=
# COSCIENTIST_REPORTS_DIR=./reports

# LLM backend override (optional). Set to 1 to force the engine's
# deterministic offline LLM backend even when a provider key is available.
# COSCIENTIST_FORCE_OFFLINE=0
# Deprecated alias for the above, still honored:
# COSCIENTIST_FORCE_MOCK=0

# Safety screening (optional). One of: standard, strict. Defaults to standard.
# In strict mode, flagged intake goals short-circuit the workflow.
# SAFETY_MODE=standard

# Contextual (semantic) safety assessment (optional). Adds a model judgment on
# top of the deterministic hard blocks, which always run first and cannot be
# overridden. Only used when the model's provider credential is present.
# SEMANTIC_SAFETY_ENABLED=true
# Model for that assessment; kept on the worker tier. (default below)
# SEMANTIC_SAFETY_MODEL=openrouter/minimax/minimax-m3:free

# Claim-grounding entailment assessor (optional). "llm" (the NLI assessor in
# claim_verifier.py, using CLAIM_VERIFIER_MODEL) or "deterministic" (offline
# lexical + negation, no provider). CLAIM_ASSESSOR is set above; the model is:
# CLAIM_VERIFIER_MODEL falls back to MODEL_NAME when unset.
# CLAIM_VERIFIER_MODEL=

# Logging (optional). LOG_FORMAT: "text" (default, human-readable) or "json"
# (one structured object per line). Both write to stdout, with run_id tagging
# on run-scoped records (see app/logging_setup.py).
# LOG_FORMAT=text

# Persistent log capture (optional). Mirror every record reaching the root
# logger into the app_logs table (served by /api/logs and the UI Logs panel).
# LOG_CAPTURE_LEVEL follows the stdlib level names; unknown values fall back
# to INFO. LOG_CAPTURE_MAX_ROWS bounds the table via periodic pruning.
# LOG_CAPTURE_ENABLED=true
# LOG_CAPTURE_LEVEL=INFO
# LOG_CAPTURE_MAX_ROWS=20000

# /status availability probes (optional). Per-probe network timeout in
# seconds, and how long a probe result is cached before re-probing.
# STATUS_PROBE_TIMEOUT_SECONDS=3.0
# STATUS_PROBE_CACHE_TTL_SECONDS=30.0

# Elo K-factor tuning (optional). The initial rating is re-exported from the
# engine's constants.py instead of being independently configurable here.
# ELO_K_FACTOR=24

# Tools configuration (optional)
# Path to a YAML tools config file for the hypothesis generator.
# Accepts: relative path (from server working dir), absolute path, or http(s):// URL.
# Leave unset to use the generator's default (no tools config).
# TOOLS_CONFIG=./config/my_tools.yaml
# TOOLS_CONFIG=/absolute/path/to/tools.yaml
# TOOLS_CONFIG=https://example.com/tools.yaml

# Literature grounding is always-on for real runs (PubMed/INDRA via MCP).
# It is never a user-facing option. Set to 0 ONLY for tests/dev that must run
# without it; the engine already degrades to LLM-only if the MCP server is down.
FORCE_LITERATURE_REVIEW=1

# Grants the app-wide persisted-log view to non-loopback callers
# (ops/CLI against a remote deployment or from Docker). Leave empty and
# only loopback callers get it; every other caller is scoped to records
# they own. REQUIRED to read logs remotely -- set a long random value.
LOGS_ADMIN_TOKEN=
# Per-client ceiling on POST /api/logs, which browsers must be able to
# reach to report their own errors.
LOGS_INGEST_PER_MINUTE=120

# Researcher auth (optional). AUTH_MODE is "compatibility" by default, which
# does NOT authenticate: private API ownership keys off an unverified
# X-Client-ID header (fine for local/demo use). AUTH_MODE=required rejects
# unauthenticated private API requests and needs BOTH AUTH_SECRET (signs
# session tokens) and RESEARCHER_ACCESS_CODES set to be usable.
# AUTH_MODE=compatibility
# AUTH_SECRET=
# RESEARCHER_ACCESS_CODES is a JSON object mapping researcher ids to their
# invite/access codes, e.g. {"alice":"code-abc","bob":"code-xyz"}.
# RESEARCHER_ACCESS_CODES={}
# How long an exchanged researcher session stays valid, in hours. (default 12)
# AUTH_SESSION_HOURS=12

# Bring-your-own-key (BYOK) support (optional). Scientists may send their own
# provider API key on run creation (X-LLM-API-Key / X-LLM-Provider request
# headers). The pair is validated with a cheap live call, then the key is
# stored ENCRYPTED for the run's lifetime (see app/credentials.py) and used
# for every LLM call that run makes, on the provider's default model
# (config.BYOK_PROVIDER_DEFAULT_MODELS). BYOK_ENCRYPTION_KEY is the secret
# the stored keys are sealed under (any non-empty string; a Fernet key is
# derived from it). Unset means BYOK is disabled and key-carrying requests
# are refused with a 503. Deliberately distinct from AUTH_SECRET so signing
# sessions and encrypting keys rotate independently. Set a long random value.
# BYOK_ENCRYPTION_KEY=

# SMTP completion notices (optional). Backs the notification.email task that
# emails a scientist when a run finishes. All unset by default (no email
# sent). PUBLIC_APP_URL is the base URL used to build run links in the email,
# so leaving it at the localhost default on a deployed server sends a link
# nobody can open.
#
# SMTP_HOST plus SMTP_FROM_EMAIL are what make the feature exist at all:
# /status reports `email_notifications_available` from those two, and the plan
# card hides its "Email me when the Goal Report is ready" opt-in without them
# rather than promising a message the server has no transport to send.
#
# Production uses Resend's SMTP relay, which needs no code of its own: the
# username is the literal string `resend` and the password is a Resend API
# key. SMTP_FROM_EMAIL must be at a domain verified in the Resend dashboard
# (ai-co-scientist.com), because Resend rejects a From address it cannot
# authenticate rather than silently rewriting it.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@ai-co-scientist.com
# PUBLIC_APP_URL=http://localhost:5173

# ===== CLI (cosci) =====
# The operator CLI (`cosci`, or `python -m app.cli`) drives the running API
# over HTTP and reads these from the environment (each also has a flag).
# COSCIENTIST_API_URL: base URL of the API to talk to (--api-url).
# COSCIENTIST_API_URL=http://localhost:8008
# COSCIENTIST_CLIENT_ID: X-Client-ID sent on requests; run listings are
# scoped by it, so use a consistent value (--client-id).
# COSCIENTIST_CLIENT_ID=
# COSCIENTIST_LOGS_TOKEN: value sent as X-Logs-Token for the app-wide log
# view / full clear; matches LOGS_ADMIN_TOKEN above (--logs-token).
# COSCIENTIST_LOGS_TOKEN=
# COSCIENTIST_TIMEOUT: per-request timeout in seconds (--timeout).
# COSCIENTIST_TIMEOUT=
