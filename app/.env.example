# Empty provider keys select the deterministic offline backend.
MODEL_NAME=openrouter/inclusionai/ling-3.1-flash

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# The default free Ling 3.1 Flash route falls back only to free Nemotron models.
OPENROUTER_API_KEY=

# Worker, supervisor, chat, and semantic-safety roles remain independently configurable.
SUPERVISOR_MODEL_NAME=openrouter/inclusionai/ling-3.1-flash
CHAT_MODEL_NAME=openrouter/inclusionai/ling-3.1-flash
SEMANTIC_SAFETY_MODEL=openrouter/inclusionai/ling-3.1-flash

APP_LLM_MAX_CALLS=4

# A wall-clock ceiling prevents accepted-but-unresponsive providers parking durable runs.
# Reasoning calls legitimately take minutes; zero disables the ceiling.
# COSCIENTIST_LLM_TIMEOUT_SECONDS=600

MCP_SERVER_URL=http://localhost:8888/mcp

HOST=0.0.0.0
PORT=8008

# SQLite has one writer; excessive worker cohorts saturate checkpoint writes.
# Eight preserves overlap while leaving API writes headroom.
# WORKER_POOL_SIZE=8
# MAX_CONCURRENT_RUNS=10

# COSCIENTIST_DB_PATH=

# COSCIENTIST_FORCE_OFFLINE=0

# Semantic safety augments deterministic hard blocks and cannot override them.
# SEMANTIC_SAFETY_ENABLED=true
# SEMANTIC_SAFETY_MODEL=openrouter/inclusionai/ling-3.1-flash

# CLAIM_VERIFIER_MODEL=

# Persistent capture bounds stored logs through periodic pruning.
# LOG_CAPTURE_ENABLED=true
# LOG_CAPTURE_LEVEL=INFO
# LOG_CAPTURE_MAX_ROWS=20000

# STATUS_PROBE_TIMEOUT_SECONDS=3.0
# STATUS_PROBE_CACHE_TTL_SECONDS=30.0

# ELO_K_FACTOR=24

# Literature grounding stays on for real runs; disabling it is only for offline development.
FORCE_LITERATURE_REVIEW=1

# Persisted-log operator access requires a token; ordinary callers see owned records.
LOGS_ADMIN_TOKEN=
LOGS_INGEST_PER_MINUTE=120

# BYOK credentials are encrypted for the run lifetime after a live validation call.
# BYOK_ENCRYPTION_KEY=

# Error reports go to Sentry only when a DSN is set (docs/MONITORING.md).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Traces export only when an OTLP endpoint is set (docs/MONITORING.md).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=co-scientist-api

# Offline runs bypass free quotas; removing the daily cap does not remove express-only
# eligibility.
# FREE_RUNS_PER_DAY=3

# A deployed email link needs a public app URL; localhost links cannot be opened remotely.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@open-coscientist.com
# Optional additional trust roots for an organization-issued SMTP certificate.
# SMTP_CA_BUNDLE=/path/to/organization-ca.pem
# PUBLIC_APP_URL=http://localhost:5173
