# LLM configuration
#
# Leave provider keys empty for deterministic mock mode. Set any supported
# LiteLLM provider key to use the real engine.
MODEL_NAME=gemini/gemini-2.5-flash

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# MODEL_NAME: worker model used by high-volume nodes: generate, review,
# ranking, reflection, evolve, proximity, and literature_review. Keep this
# model fast enough for repeated calls.
#
# SUPERVISOR_MODEL_NAME (optional): high-reasoning model for strategic nodes:
#   - supervisor  → plans the research workflow at the start of every iteration
#   - meta_review → synthesizes all reviews and writes the final report
# If unset, both nodes fall back to MODEL_NAME (useful for testing / cost saving).
# SUPERVISOR_MODEL_NAME=
#
# CHAT_MODEL_NAME (optional): model used for Chat tab Q&A. Defaults to MODEL_NAME.
# CHAT_MODEL_NAME=

# MCP server configuration (optional, required only for literature tools)
# MCP_SERVER_URL: URL of the MCP server providing literature review tools
# Leave empty or comment out to disable literature review (graceful degradation)
MCP_SERVER_URL=http://localhost:8888/mcp

# Server Configuration
HOST=0.0.0.0
PORT=8008

DEBUG=FALSE

# Cache configuration (optional)
COSCIENTIST_CACHE_ENABLED=true
COSCIENTIST_CACHE_DIR=./cache

# Storage paths (optional). Read directly from the environment by app/store/db.py.
# COSCIENTIST_DB_PATH: SQLite database path. Unset uses the app default.
# COSCIENTIST_REPORTS_DIR: directory for rendered Markdown reports (default ./reports).
# COSCIENTIST_DB_PATH=
# COSCIENTIST_REPORTS_DIR=./reports

# Provider override (optional). Set to 1 to force the deterministic mock
# workflow even when a provider key and the engine are available.
# COSCIENTIST_FORCE_MOCK=0

# Safety screening (optional). One of: standard, strict. Defaults to standard.
# In strict mode, flagged intake goals short-circuit the workflow.
# SAFETY_MODE=standard

# Logging (optional). LOG_FORMAT: "text" (default, human-readable) or "json"
# (one structured object per line). Both write to stdout, with run_id tagging
# on run-scoped records (see app/logging_setup.py).
# LOG_FORMAT=text

# /status availability probes (optional). Per-probe network timeout in
# seconds, and how long a probe result is cached before re-probing.
# STATUS_PROBE_TIMEOUT_SECONDS=3.0
# STATUS_PROBE_CACHE_TTL_SECONDS=30.0

# Elo tuning (optional). Read directly by app/elo.py; mirror the engine's
# constants.py so mock and real tournaments stay consistent.
# ELO_INITIAL=1200
# ELO_K_FACTOR=24
# ELO_UPSET_MARGIN=100

# Tools configuration (optional)
# Path to a YAML tools config file for the hypothesis generator.
# Accepts: relative path (from server working dir), absolute path, or http(s):// URL.
# Leave unset to use the generator's default (no tools config).
# TOOLS_CONFIG=./config/my_tools.yaml
# TOOLS_CONFIG=/absolute/path/to/tools.yaml
# TOOLS_CONFIG=https://example.com/tools.yaml

# Literature grounding is always-on for real runs (PubMed/INDRA via MCP).
# It is never a user-facing option. Set to 0 ONLY for tests/dev that must run
# without it; the engine already degrades to LLM-only if the MCP server is down.
FORCE_LITERATURE_REVIEW=1
