# syntax=docker/dockerfile:1
#
# Sibling: repo-root Dockerfile.api (Railway). The two are deliberately
# divergent -- this one (docker-compose) installs the engine at startup from a
# mounted checkout via entrypoint.sh and mounts the corpus as a volume, while
# the Railway file bakes both the engine source and the corpus into the image
# at build time. A change to app deps, corpus handling, or the run command here
# usually needs a mirrored change there.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy and install viewer deps first (layer cache before source copy).
# The engine is installed at container startup by entrypoint.sh from the
# mounted checkout, so skip the local engine package dependency at build time
# (--no-deps) and install the runtime deps from the single-sourced
# requirements-app.txt (mirrors pyproject minus the engine pin).
COPY pyproject.toml requirements-app.txt ./
RUN pip install --no-cache-dir -e . --no-deps \
    && pip install --no-cache-dir -r requirements-app.txt

# copy application source
COPY app/ ./app/

RUN mkdir -p /app/cache

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8008

ENTRYPOINT ["/entrypoint.sh"]
