            "text": "{\"configId\":\"ecdc11ff-7bbf-4477-a1e9-b47224dce12a\",\"additionalParams\":{\"token\":\"-\",\"origin\":\"ORIGIN_UNSPECIFIED\"},\"location\":\"global\",\"getIdeaRequest\":{\"name\":\"collections/default_collection/engines/gemini-enterprise-17812649_1781265009861/sessions/12976829802316813348/ideaForgeInstances/6654882792859087362/ideaForgeIdeas/16691556177830690355\"}}"
