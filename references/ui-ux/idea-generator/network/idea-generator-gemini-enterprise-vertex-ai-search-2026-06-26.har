          "content": {
            "size": 2864,
            "mimeType": "application/json",
            "text": "{\n  \"ideaForgeInstance\": {\n    \"name\": \"collections/default_collection/engines/gemini-enterprise-17812649_1781265009861/sessions/1510343080752628271/ideaForgeInstances/15457651198283565650\",\n    \"config\": {\n      \"userInput\": \"Generate concepts for an automated performance review system.\",\n      \"title\": \"Automated Performance Review System Concepts\",\n      \"goal\": \"Propose an innovative concept for an automated performance review system.\",\n      \"attributes\": [\n        {\n          \"name\": \"Core Technology\",\n          \"extractor\": \"Identify the primary technological approach used (e.g., AI/ML, Data Analytics, NLP, Gamification, Behavioral Science).\"\n        },\n        {\n          \"name\": \"Key Feature\",\n          \"extractor\": \"What is the most distinctive or innovative feature of this system? (2-4 words)\"\n        },\n        {\n          \"name\": \"User Focus\",\n          \"extractor\": \"Who is the primary beneficiary of this system? (e.g., Employee, Manager, HR, All)\"\n        },\n        {\n          \"name\": \"Novelty Score\",\n          \"extractor\": \"Rate the novelty of the concept on a scale of 1 to 5 (1 - commonplace, 3 - somewhat novel, 5 - truly groundbreaking).\"\n        },\n        {\n          \"name\": \"Feasibility Score\",\n          \"extractor\": \"Rate the practical feasibility of implementing this concept on a scale of 1 to 5 (1 - highly theoretical, 3 - feasible with effort, 5 - easily implementable).\"\n        },\n        {\n          \"name\": \"Impact Score\",\n          \"extractor\": \"Rate the potential positive impact of this system on performance reviews on a scale of 1 to 5 (1 - minor improvement, 3 - significant improvement, 5 - transformative).\"\n        },\n        {\n          \"name\": \"Ethical Consideration Score\",\n          \"extractor\": \"Rate how well ethical concerns (e.g., bias, privacy) are addressed or inherently mitigated, on a scale of 1 to 5 (1 - high unaddressed concerns, 3 - some considerations, 5 - robust ethical framework).\"\n        }\n      ],\n      \"preferences\": [\n        \"The concept must leverage automation to improve the efficiency, objectivity, and fairness of the performance review process.\",\n        \"The system should address common pain points of traditional performance reviews, such as bias, subjectivity, time consumption, or lack of continuous feedback.\",\n        \"The proposed concept should be practical and feasible for implementation within a corporate or organizational setting.\",\n        \"Focus on how the system would benefit employees, managers, and/or HR departments.\",\n        \"Ideas should clearly articulate the core functionality and the technological approach.\"\n      ],\n      \"shouldBeCorrect\": true,\n      \"shouldBeNovel\": true,\n      \"shouldMaximizeImpact\": true\n    },\n    \"state\": \"CREATING\",\n    \"metadata\": {\n      \"createTime\": \"2026-06-20T17:28:27.865011Z\"\n    },\n    \"stats\": {}\n  }\n}\n"
          },
