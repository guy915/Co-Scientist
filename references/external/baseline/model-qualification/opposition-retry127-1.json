  "invocation_source": "import datetime, hashlib, json, os, sys\nfrom pathlib import Path\nfrom evaluations._live_config import configure_live_environment\nmodel = configure_live_environment()\nimport probe_citation_panel as probe\nfrom app import claim_verifier_opposition as opposition\nfrom co_scientist.llm_free_catalog import current_catalog, verify_model\nfolder = Path(os.environ['QUALIFICATION_FOLDER'])\noutput = Path(os.environ['QUALIFICATION_OUTPUT'])\ncontrols = folder / 'historical-negative-controls.json'\nrecord = {'purpose': 'Q2 live schema compatibility; primary-controlled control labelled separately', 'trial': int(os.environ['QUALIFICATION_TRIAL']), 'source_commit': os.environ['QUALIFICATION_REVISION'], 'model': model, 'started_at': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'controls_sha256': probe.digest(controls), 'invocation_source': Path(__file__).read_text(), 'verifier_requests': []}\noriginal = opposition.call_llm_json\nasync def observed(prompt, spec, **kwargs):\n    pairs = json.loads(prompt[len(opposition._PROMPT):])\n    invocation = {'pair_count': len(pairs), 'schema': spec.json_schema, 'max_attempts': kwargs.get('max_attempts'), 'phase': probe._PHASE}\n    record['verifier_requests'].append(invocation)\n    try:\n        result = await original(prompt, spec, **kwargs)\n        invocation['returned'] = result\n        return result\n    except Exception as exc:\n        invocation['error_type'] = type(exc).__name__\n        raise\nopposition.call_llm_json = observed\nwith output.open('x') as artifact:\n    try:\n        catalog = current_catalog()\n        raw = model.removeprefix('openrouter/')\n        verify_model(raw, catalog)\n        record['eligibility'] = catalog[raw]\n        record['sources'] = probe.install_assessment_observer(Path.cwd())\n        probe.litellm.acompletion = probe.observed_transport\n        record['historical'], record['controlled_primary'] = probe.historical_controls(json.loads(controls.read_text()))\n    except Exception as exc:\n        record['error_type'] = type(exc).__name__\n        record['error'] = str(exc).replace(os.environ['OPENROUTER_API_KEY'], '[redacted]')[:1500]\n    finally:\n        record['physical_requests'] = probe._REQUESTS\n        record['finished_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\n        artifact.write(json.dumps(record, indent=2)+'\\n')\nprint(json.dumps({'trial': record['trial'], 'error_type': record.get('error_type'), 'physical_requests': len(probe._REQUESTS)}), flush=True)\nsys.exit(1 if record.get('error_type') else 0)\n",
