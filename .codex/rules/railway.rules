# Co-Scientist routine inspection and protected deployment policy.
prefix_rule(
    pattern = ["ruff", ["check", "format"]],
    decision = "allow",
    justification = "Routine local linting and formatting for Co-Scientist.",
)

prefix_rule(
    pattern = ["railway", ["logs", "status"]],
    decision = "allow",
    justification = "Read-only Railway inspection for Co-Scientist.",
)

prefix_rule(
    pattern = ["railway", ["up", "deploy", "redeploy", "run", "down", "variables"]],
    decision = "prompt",
    justification = "This may deploy, execute remotely, mutate production variables, or tear down Railway resources.",
)

prefix_rule(
    pattern = ["railway", "service", "delete"],
    decision = "prompt",
    justification = "Deleting a Railway service requires confirmation.",
)

prefix_rule(
    pattern = ["railway", "environment", "delete"],
    decision = "prompt",
    justification = "Deleting a Railway environment requires confirmation.",
)
