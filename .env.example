# Settings resolve .env from cwd; make links app/.env to the root file to avoid divergent
# copies.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# The default free Ling 3.1 Flash route falls back only to free Nemotron models.
OPENROUTER_API_KEY=

# Decisions stay on the existing LLM until a site passes its bake-off.
LIQUID_API_KEY=
DECISION_ENABLED=false
DECISION_MODEL_NAME=d1:free
DECISION_BASE_URL=https://api.liquid.ai/decisions/v1
DECISION_TIMEOUT_SECONDS=15
DECISION_MAX_CALLS_PER_DAY=256
DECISION_MAX_TOKENS_PER_DAY=4000000
DECISION_MAX_INPUT_BYTES=131072
DECISION_MAX_QUESTIONS=32

MODEL_NAME=openrouter/inclusionai/ling-3.1-flash

COSCIENTIST_DB_PATH=./coscientist.db

HOST=0.0.0.0
PORT=8008

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://open-coscientist.com

# An empty MCP endpoint disables literature retrieval with graceful degradation.
MCP_SERVER_URL=http://localhost:8888/mcp

ELO_K_FACTOR=24

# Direct DeepSeek overrides select 0423 weights, ranked below the 0731 snapshot.
# MODEL_NAME=deepseek/deepseek-v4-flash
# SUPERVISOR_MODEL_NAME=deepseek/deepseek-v4-pro
# CHAT_MODEL_NAME=deepseek/deepseek-v4-pro
# SEMANTIC_SAFETY_MODEL=deepseek/deepseek-v4-flash

APP_LLM_MAX_CALLS=4
