# AI Co-Scientist — root environment defaults
# Copy to .env (`make setup` does this). With no provider keys set, every run
# uses the engine's deterministic offline LLM backend — no key required.
# Full reference for every viewer env var: app/.env.example
#
# `make setup`/`make dev-api` also symlink app/.env -> ../.env: dev-api runs
# with cwd=app/, and Settings loads ".env" relative to cwd, so a root-only
# .env is otherwise invisible to it. There is one file, not two to keep in
# sync — edit this one, not app/.env.

# ----- LLM provider keys (optional; absence selects the offline backend) -----
# Set any supported LiteLLM provider key to use a real model.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# The key the defaults below need: every tier runs on GLM 5.2's free pool
# through OpenRouter, with an all-free fallback chain behind it.
OPENROUTER_API_KEY=

# Worker model, LiteLLM format. Examples:
# openrouter/z-ai/glm-5.2:free, gemini/gemini-2.5-flash.
MODEL_NAME=openrouter/z-ai/glm-5.2:free

# ----- Storage -----
# SQLite path for runs, events, hypotheses, evidence, matches, reports.
# Default lives at the repo root for easy reset via `make reset-db`.
COSCIENTIST_DB_PATH=./coscientist.db

# Markdown reports + JSON exports land here.
COSCIENTIST_REPORTS_DIR=./reports

# ----- Server -----
HOST=0.0.0.0
PORT=8008
COSCIENTIST_DEBUG=false

# CORS allowlist for the UI dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- MCP (literature retrieval) -----
# `make start` launches the reference MCP server on 8888; keep this pointing
# at it. Leaving it empty disables literature review (graceful degradation).
MCP_SERVER_URL=http://localhost:8888/mcp

# ----- Cache -----
COSCIENTIST_CACHE_ENABLED=true
COSCIENTIST_CACHE_DIR=./cache

# ----- Elo / tournament tuning -----
# K-factor only; the initial rating comes from the engine's constants.py.
ELO_K_FACTOR=24

# ----- Safety -----
# One of: standard, strict.
SAFETY_MODE=standard

# ----- Staying on DeepSeek's own API instead (optional) -----
# The defaults route the same DeepSeek weights through OpenRouter, where a
# dozen hosts compete to serve an open-weights model: measured on this
# project's own workload, one research goal costs about $0.003 that way
# against $0.005 at DeepSeek's first-party Flash rate and $0.025 at its Pro
# rate (first-party V4 peak is $0.44/$1.32 per million tokens on Flash and
# $1.32/$3.96 on Pro, halved outside 01:00-04:00 and 06:00-10:00 UTC).
#
# To go back to DeepSeek directly, set DEEPSEEK_API_KEY and uncomment these.
# They name the 0423 weights, which blind judging ranked well below the
# 0731 snapshot the default routes to -- so this is a quality change as
# well as a routing one.
# MODEL_NAME=deepseek/deepseek-v4-flash
# SUPERVISOR_MODEL_NAME=deepseek/deepseek-v4-pro
# CHAT_MODEL_NAME=deepseek/deepseek-v4-pro
# SEMANTIC_SAFETY_MODEL=deepseek/deepseek-v4-flash
