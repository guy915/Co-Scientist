# AI Co-Scientist — root environment defaults
# Copy to .env (`make setup` does this). With no provider keys set, every run
# uses the engine's deterministic offline LLM backend — no key required.
# Full reference for every viewer env var: app/.env.example

# ----- LLM provider keys (optional; absence selects the offline backend) -----
# Set any supported LiteLLM provider key to use a real model.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Worker model, LiteLLM format. Examples: deepseek/deepseek-v4-flash,
# dashscope/deepseek-v4-flash, gemini/gemini-2.5-flash.
MODEL_NAME=deepseek/deepseek-v4-flash

# ----- Storage -----
# SQLite path for runs, events, hypotheses, evidence, matches, reports.
# Default lives at the repo root for easy reset via `make reset-db`.
COSCIENTIST_DB_PATH=./coscientist.db

# Markdown reports + JSON exports land here.
COSCIENTIST_REPORTS_DIR=./reports

# ----- Server -----
HOST=0.0.0.0
PORT=8008
DEBUG=false

# CORS allowlist for the UI dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- MCP (literature retrieval) -----
# `make start` launches the reference MCP server on 8888; keep this pointing
# at it. Leaving it empty disables literature review (graceful degradation).
MCP_SERVER_URL=http://localhost:8888/mcp

# ----- Cache -----
COSCIENTIST_CACHE_ENABLED=true
COSCIENTIST_CACHE_DIR=./cache

# ----- Elo / tournament tuning -----
# K-factor only; the initial rating comes from the engine's constants.py.
ELO_K_FACTOR=24

# ----- Safety -----
# One of: standard, strict.
SAFETY_MODE=standard
